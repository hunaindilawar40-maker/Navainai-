# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real keys.
#
# Locally:  cp .env.example .env.local  &&  npm run dev
# On Vercel: Project → Settings → Environment Variables → add the same names.
#            (After changing them, redeploy for the new values to take effect.)

# --- Required for the "Stacy" chat widget -------------------------------
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional — override the chat model (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Optional: voice / text-to-speech (ElevenLabs) ----------------------
# Either name works, ELEVEN_API_KEY is preferred.
# https://elevenlabs.io → Profile → API Keys
ELEVEN_API_KEY=
# ELEVEN_KEY=
# ELEVEN_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVEN_MODEL=eleven_turbo_v2
